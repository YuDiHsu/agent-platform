# Copy to .env before `docker compose up`.
# API containers reach Postgres and Redis by service name.
# The browser reaches the API through the published host port.

DATABASE_URL=postgresql+asyncpg://eamp:eamp@postgres:5432/eamp
DATABASE_NULL_POOL=false
REDIS_URL=redis://redis:6379/0
SGLANG_BASE_URL=http://localhost:30000/v1
SGLANG_API_KEY=local
EMBEDDING_BASE_URL=http://localhost:8081/v1
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_API_KEY=local
# 32-byte AES-256 key, base64. Generate a unique value before starting the API.
TOKEN_VAULT_KEY=REPLACE_WITH_32_BYTE_BASE64
SEED_ON_STARTUP=true
CORS_ORIGINS=http://localhost:3000
